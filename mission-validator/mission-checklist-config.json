{
  "version": "1.0.0",
  "description": "DCS Mission Validation Checklist Configuration",
  "categories": [
    {
      "id": "naming",
      "name": "Naming Conventions",
      "priority": "high",
      "rules": [
        {
          "id": "naming-001",
          "name": "BLUE Force Naming",
          "description": "All AI/Static BLUE forces should be named 'BLUE-Name'",
          "severity": "warning",
          "type": "naming_pattern",
          "pattern": "^BLUE-",
          "target": {
            "coalitions": ["blue"],
            "unitTypes": ["plane", "helicopter", "ground", "ship"]
          },
          "appliesTo": "ai_static_only"
        },
        {
          "id": "naming-002",
          "name": "RED Force Naming",
          "description": "All AI/Static RED forces should be named 'RED-Name'",
          "severity": "warning",
          "type": "naming_pattern",
          "pattern": "^RED-",
          "target": {
            "coalitions": ["red"],
            "unitTypes": ["plane", "helicopter", "ground", "ship"]
          },
          "appliesTo": "ai_static_only"
        }
      ]
    },
    {
      "id": "farp",
      "name": "FARP Operations",
      "priority": "critical",
      "rules": [
        {
          "id": "farp-001",
          "name": "FARP Distance from RED",
          "description": "FARP must be at least 10nm away from RED forces",
          "severity": "error",
          "type": "distance_check",
          "minDistance": 18520,
          "unit": "meters",
          "target": {
            "type": "farp",
            "referenceType": "red_forces"
          }
        },
        {
          "id": "farp-002",
          "name": "FARP Dynamic Spawn",
          "description": "FARP must have Dynamic Spawn enabled",
          "severity": "error",
          "type": "property_check",
          "property": "dynamicSpawn",
          "expectedValue": true,
          "target": {
            "type": "farp"
          }
        },
        {
          "id": "farp-003",
          "name": "FARP Hot Start",
          "description": "FARP must allow Hot Start",
          "severity": "error",
          "type": "property_check",
          "property": "allowHotStart",
          "expectedValue": true,
          "target": {
            "type": "farp"
          }
        },
        {
          "id": "farp-004",
          "name": "FARP Support Buildings",
          "description": "FARP must have Ammo Depot and Fuel Depot nearby",
          "severity": "warning",
          "type": "proximity_check",
          "requiredBuildings": ["ammo_depot", "fuel_depot"],
          "maxDistance": 500,
          "unit": "meters",
          "target": {
            "type": "farp"
          }
        },
        {
          "id": "farp-005",
          "name": "FARP Wind Sock",
          "description": "FARP should have a wind sock",
          "severity": "info",
          "type": "presence_check",
          "requiredObjects": ["windsock"],
          "target": {
            "type": "farp"
          }
        }
      ]
    },
    {
      "id": "awacs",
      "name": "AWACS Configuration",
      "priority": "high",
      "rules": [
        {
          "id": "awacs-001",
          "name": "AWACS Range Positioning",
          "description": "AWACS should not be set too close to the action (max 180nm range)",
          "severity": "warning",
          "type": "distance_check",
          "maxDistance": 333360,
          "unit": "meters",
          "target": {
            "task": "AWACS"
          },
          "referenceType": "combat_zone"
        },
        {
          "id": "awacs-002",
          "name": "AWACS Frequency",
          "description": "AWACS frequency should be set to 305.00 MHz",
          "severity": "error",
          "type": "frequency_check",
          "expectedFrequency": 305.00,
          "tolerance": 0.01,
          "target": {
            "task": "AWACS"
          }
        },
        {
          "id": "awacs-003",
          "name": "AWACS Altitude",
          "description": "AWACS altitude should be above 30,000 feet",
          "severity": "error",
          "type": "altitude_check",
          "minAltitude": 30000,
          "unit": "feet",
          "target": {
            "task": "AWACS"
          }
        },
        {
          "id": "awacs-004",
          "name": "AWACS Waypoints",
          "description": "AWACS should have at least 2 waypoints for orbit pattern",
          "severity": "info",
          "type": "waypoint_count",
          "minCount": 2,
          "target": {
            "task": "AWACS"
          }
        },
        {
          "id": "awacs-005",
          "name": "AWACS Orbit Pattern",
          "description": "AWACS should have Orbit or Race-track pattern on at least one waypoint",
          "severity": "error",
          "type": "awacs_orbit",
          "target": {
            "task": "AWACS"
          }
        },
        {
          "id": "awacs-006",
          "name": "AWACS Advanced Options",
          "description": "AWACS should have unlimited fuel, invincible, and invisible settings",
          "severity": "warning",
          "type": "advanced_options",
          "requiredOptions": ["unlimitedFuel", "invincible", "invisible"],
          "target": {
            "task": "AWACS"
          }
        }
      ]
    },
    {
      "id": "tanker",
      "name": "Tanker Configuration",
      "priority": "high",
      "rules": [
        {
          "id": "tanker-001",
          "name": "Tanker Altitude",
          "description": "Tanker altitude should be set to 20,000 feet",
          "severity": "warning",
          "type": "altitude_check",
          "expectedAltitude": 20000,
          "tolerance": 1000,
          "unit": "feet",
          "target": {
            "task": "Tanker"
          }
        },
        {
          "id": "tanker-002",
          "name": "Tanker Speed",
          "description": "Tanker speed should be 300 knots or less",
          "severity": "error",
          "type": "speed_check",
          "maxSpeed": 300,
          "unit": "knots",
          "target": {
            "task": "Tanker"
          }
        },
        {
          "id": "tanker-003",
          "name": "Tanker Late Activation",
          "description": "Tankers should have Late Activation enabled",
          "severity": "warning",
          "type": "property_check",
          "property": "lateActivation",
          "expectedValue": true,
          "target": {
            "task": "Tanker"
          }
        },
        {
          "id": "tanker-004",
          "name": "KC130 Configuration",
          "description": "KC130 should use 255.00 MHz and TACAN 10X",
          "severity": "error",
          "type": "aircraft_config",
          "aircraftType": "KC130",
          "expectedConfig": {
            "frequency": 255.00,
            "tacan": "10X"
          },
          "target": {
            "type": "tanker",
            "aircraftType": "KC130"
          }
        },
        {
          "id": "tanker-005",
          "name": "KC135 Configuration",
          "description": "KC135 should use 257.00 MHz and TACAN 11X",
          "severity": "error",
          "type": "aircraft_config",
          "aircraftType": "KC135",
          "expectedConfig": {
            "frequency": 257.00,
            "tacan": "11X"
          },
          "target": {
            "type": "tanker",
            "aircraftType": "KC135"
          }
        },
        {
          "id": "tanker-006",
          "name": "KC135-MPRS Configuration",
          "description": "KC135-MPRS should use 259.00 MHz and TACAN 12X",
          "severity": "error",
          "type": "aircraft_config",
          "aircraftType": "KC135-MPRS",
          "expectedConfig": {
            "frequency": 259.00,
            "tacan": "12X"
          },
          "target": {
            "type": "tanker",
            "aircraftType": "KC135-MPRS"
          }
        }
      ]
    },
    {
      "id": "carrier",
      "name": "Carrier Configuration",
      "priority": "critical",
      "rules": [
        {
          "id": "carrier-001",
          "name": "CVN73 Frequency",
          "description": "CVN73 George Washington should use 127.500 MHz",
          "severity": "error",
          "type": "carrier_config",
          "carrierType": "CVN73",
          "expectedConfig": {
            "frequency": 127.500,
            "tacan": "73X",
            "ils": 3,
            "airboss": true,
            "airbossPassword": "fsjboss"
          }
        },
        {
          "id": "carrier-002",
          "name": "CVN74 Frequency",
          "description": "CVN74 Stennis should use 129.00 MHz",
          "severity": "error",
          "type": "carrier_config",
          "carrierType": "CVN74",
          "expectedConfig": {
            "frequency": 129.00,
            "tacan": "74X",
            "ils": 4,
            "airboss": true,
            "airbossPassword": "fsjboss"
          }
        },
        {
          "id": "carrier-003",
          "name": "Carrier Dynamic Spawn",
          "description": "Carriers should have Dynamic Spawn enabled",
          "severity": "error",
          "type": "property_check",
          "property": "dynamicSpawn",
          "expectedValue": true,
          "target": {
            "type": "carrier"
          }
        },
        {
          "id": "carrier-004",
          "name": "Carrier Hot Start",
          "description": "Carriers should allow Hot Start",
          "severity": "error",
          "type": "property_check",
          "property": "allowHotStart",
          "expectedValue": true,
          "target": {
            "type": "carrier"
          }
        }
      ]
    },
    {
      "id": "red_air",
      "name": "RED Air Forces",
      "priority": "high",
      "rules": [
        {
          "id": "redair-001",
          "name": "RED Air Advanced Options",
          "description": "RED air should have unlimited fuel and afterburner restriction",
          "severity": "warning",
          "type": "advanced_options",
          "requiredOptions": ["unlimitedFuel", "restrictAfterburner"],
          "target": {
            "coalition": "red",
            "unitType": "plane"
          }
        },
        {
          "id": "redair-002",
          "name": "RED Air Task",
          "description": "RED air should have CAP or Search/Engage task",
          "severity": "warning",
          "type": "task_check",
          "allowedTasks": ["CAP", "Search and Engage", "Intercept"],
          "target": {
            "coalition": "red",
            "unitType": "plane"
          }
        },
        {
          "id": "redair-003",
          "name": "RED Air Patrol Pattern",
          "description": "RED air should have circular patrol pattern (waypoints loop back)",
          "severity": "info",
          "type": "pattern_check",
          "expectedPattern": "circular",
          "target": {
            "coalition": "red",
            "task": "CAP"
          }
        }
      ]
    },
    {
      "id": "blue_aircraft",
      "name": "BLUE Aircraft Configuration",
      "priority": "critical",
      "rules": [
        {
          "id": "blue-001",
          "name": "BLUE Aircraft Client Type",
          "description": "BLUE aircraft should be set to Client type",
          "severity": "error",
          "type": "property_check",
          "property": "controlled",
          "expectedValue": false,
          "target": {
            "coalition": "blue",
            "unitType": "plane",
            "isPlayer": true
          }
        },
        {
          "id": "blue-002",
          "name": "COMM Channels Set",
          "description": "BLUE aircraft should have communication channels configured",
          "severity": "error",
          "type": "comm_check",
          "requiredChannels": ["UHF", "VHF"],
          "target": {
            "coalition": "blue",
            "isPlayer": true
          }
        },
        {
          "id": "blue-003",
          "name": "SEAD Frequency",
          "description": "SEAD missions should use 131.00 MHz",
          "severity": "warning",
          "type": "frequency_check",
          "expectedFrequency": 131.00,
          "tolerance": 0.01,
          "target": {
            "coalition": "blue",
            "task": "SEAD"
          }
        },
        {
          "id": "blue-004",
          "name": "CAP Frequency",
          "description": "CAP missions should use 135.00 MHz",
          "severity": "warning",
          "type": "frequency_check",
          "expectedFrequency": 135.00,
          "tolerance": 0.01,
          "target": {
            "coalition": "blue",
            "task": "CAP"
          }
        },
        {
          "id": "blue-005",
          "name": "STRIKE Frequency",
          "description": "STRIKE missions should use 137.50 MHz",
          "severity": "warning",
          "type": "frequency_check",
          "expectedFrequency": 137.50,
          "tolerance": 0.01,
          "target": {
            "coalition": "blue",
            "task": "Strike"
          }
        },
        {
          "id": "blue-006",
          "name": "ROTARY Frequency",
          "description": "ROTARY missions should use 30 FM",
          "severity": "warning",
          "type": "frequency_check",
          "expectedFrequency": 30.00,
          "tolerance": 0.01,
          "target": {
            "coalition": "blue",
            "unitType": "helicopter"
          }
        },
        {
          "id": "blue-007",
          "name": "F14 INS Configuration",
          "description": "F14 cold starts should have INS enabled on 7th tab",
          "severity": "warning",
          "type": "aircraft_specific",
          "aircraftType": "F14",
          "condition": "cold_start",
          "check": "ins_enabled",
          "target": {
            "coalition": "blue",
            "aircraftType": "F14"
          }
        }
      ]
    },
    {
      "id": "bases",
      "name": "Base Configuration",
      "priority": "high",
      "rules": [
        {
          "id": "base-001",
          "name": "BLUE Base Dynamic Spawn",
          "description": "BLUE bases should have Dynamic Spawn enabled",
          "severity": "error",
          "type": "property_check",
          "property": "dynamicSpawn",
          "expectedValue": true,
          "target": {
            "coalition": "blue",
            "type": "base"
          }
        },
        {
          "id": "base-002",
          "name": "BLUE Base Hot Start",
          "description": "BLUE bases should allow Hot Start",
          "severity": "error",
          "type": "property_check",
          "property": "allowHotStart",
          "expectedValue": true,
          "target": {
            "coalition": "blue",
            "type": "base"
          }
        },
        {
          "id": "base-003",
          "name": "RED Force Proximity",
          "description": "No RED forces within 10nm of BLUE base",
          "severity": "error",
          "type": "distance_check",
          "minDistance": 18520,
          "unit": "meters",
          "target": {
            "coalition": "blue",
            "type": "base"
          },
          "referenceType": "red_forces"
        }
      ]
    },
    {
      "id": "weather",
      "name": "Weather Settings",
      "priority": "medium",
      "rules": [
        {
          "id": "weather-001",
          "name": "Time of Day",
          "description": "Mission should be set at Sunrise",
          "severity": "info",
          "type": "time_check",
          "expectedTime": "sunrise",
          "tolerance": 3600
        },
        {
          "id": "weather-002",
          "name": "Cloud Cover",
          "description": "Clouds should be 'High Scattered 3'",
          "severity": "info",
          "type": "weather_check",
          "expectedClouds": "High Scattered 3",
          "cloudPreset": 3
        },
        {
          "id": "weather-003",
          "name": "Wind Speed",
          "description": "Wind should be less than 6 knots",
          "severity": "warning",
          "type": "wind_check",
          "maxSpeed": 6,
          "unit": "knots"
        }
      ]
    },
    {
      "id": "cleanup",
      "name": "Mission Cleanup",
      "priority": "high",
      "rules": [
        {
          "id": "cleanup-001",
          "name": "No Test Aircraft",
          "description": "Mission should not contain test aircraft",
          "severity": "error",
          "type": "absence_check",
          "forbiddenPatterns": ["test", "debug", "temp"],
          "target": {
            "unitTypes": ["plane", "helicopter"]
          }
        },
        {
          "id": "cleanup-002",
          "name": "No Test Scripting",
          "description": "Mission should not contain test scripting",
          "severity": "error",
          "type": "script_check",
          "forbiddenPatterns": ["test", "debug", "temp"],
          "target": {
            "type": "triggers"
          }
        }
      ]
    }
  ],
  "severityLevels": {
    "critical": {
      "weight": 4,
      "description": "Mission-breaking error",
      "autoFix": false
    },
    "error": {
      "weight": 3,
      "description": "Must be fixed before mission approval",
      "autoFix": false
    },
    "warning": {
      "weight": 2,
      "description": "Should be fixed, mission may still be usable",
      "autoFix": true
    },
    "info": {
      "weight": 1,
      "description": "Suggestion for improvement",
      "autoFix": true
    }
  }
}
